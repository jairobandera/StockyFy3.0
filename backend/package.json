{
  "name": "stockify-backend",
  "version": "2.0.0",
  "description": "Stockify backend - facturacion y control de stock - Node.js crudo (http nativo + ws) + PostgreSQL",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:init": "node scripts/init-db.js",
